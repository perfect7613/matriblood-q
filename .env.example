# Copy to .env.local for local development. Do not commit real secrets.

# Supabase
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# TokenRouter
TOKENROUTER_API_KEY=
TOKENROUTER_BASE_URL=https://api.tokenrouter.io
TOKENROUTER_MODEL=openai/gpt-4.1-mini

# ElevenLabs, optional for Phase 2 voice polish
ELEVENLABS_API_KEY=

# Local services
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
API_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
