{
  "name": "matriblood-q",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/web"
  ],
  "scripts": {
    "dev": "npm run dev --workspace apps/web",
    "build": "npm run build --workspace apps/web",
    "lint": "npm run lint --workspace apps/web",
    "typecheck": "npm run typecheck --workspace apps/web",
    "api": "uv run uvicorn app.main:app --app-dir services/api",
    "api:dev": "uv run uvicorn app.main:app --reload --reload-exclude .venv --app-dir services/api",
    "api:test": "python3 -m pytest services/api/tests",
    "seed:local-json": "python3 services/api/scripts/write_seed_snapshot.py"
  }
}
